# Copy to .env and adjust for local dev. Docker Compose service names
# (postgres/redis) are used automatically inside containers; these
# localhost values are for running apps/api directly on the host.

ENVIRONMENT=local

DATABASE_URL=postgresql+psycopg://datalume:datalume@localhost:5433/datalume
REDIS_URL=redis://localhost:6380/0

SESSION_COOKIE_NAME=datalume_session
SECRET_KEY=dev-only-change-me

# Stripe (Sprint 2 — SaaS billing, architecture/07-platform-services.md §2).
# Unset means NullBillingProvider — checkout/portal/webhook all fail
# loudly with a clear "not configured" error rather than silently
# no-opping (see app/integrations/billing_provider.py).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
WEB_APP_URL=http://localhost:3100

# Ask DataLume (Sprint 22 — architecture/06-intelligence-layer.md §1-2).
# Unset means the LLM interpretation layer is not configured — tool
# selection and grounded data still work (see app/integrations/
# llm_provider.py), only the natural-language write-up is unavailable.
ANTHROPIC_API_KEY=

NEXT_PUBLIC_API_URL=http://localhost:8000
