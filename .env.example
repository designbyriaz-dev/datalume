# Copy to .env and adjust for local dev. Docker Compose service names
# (postgres/redis) are used automatically inside containers; these
# localhost values are for running apps/api directly on the host.

ENVIRONMENT=local

DATABASE_URL=postgresql+psycopg://datalume:datalume@localhost:5433/datalume
REDIS_URL=redis://localhost:6380/0

SESSION_COOKIE_NAME=datalume_session
SECRET_KEY=dev-only-change-me

# Stripe (Sprint 2 — SaaS billing, architecture/07-platform-services.md §2)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

NEXT_PUBLIC_API_URL=http://localhost:8000
